# Windows version resource for qtRequestory.exe.
#
# TEMPLATE. scripts/make_version_info.py fills @MAJOR@/@MINOR@/@PATCH@/@VERSION@
# from qtrequestory.__version__ and writes scripts/version_info.txt (not
# committed). Keep this file ASCII-only: PyInstaller execs it and the resource
# is read back by tools with assorted code pages.
#
# Language 040904B0 / Translation [1033, 1200] = en-US, Unicode code page.
VSVersionInfo(
  ffi=FixedFileInfo(
    filevers=(@MAJOR@, @MINOR@, @PATCH@, 0),
    prodvers=(@MAJOR@, @MINOR@, @PATCH@, 0),
    mask=0x3f,
    flags=0x0,
    OS=0x40004,
    fileType=0x1,
    subtype=0x0,
    date=(0, 0)
  ),
  kids=[
    StringFileInfo(
      [
        StringTable(
          '040904B0',
          [
            StringStruct('CompanyName', ''),
            StringStruct('FileDescription', 'qtRequestory - mirror, search and extract request logs'),
            StringStruct('FileVersion', '@VERSION@'),
            StringStruct('InternalName', 'qtRequestory'),
            StringStruct('LegalCopyright', 'MIT License'),
            StringStruct('OriginalFilename', 'qtRequestory.exe'),
            StringStruct('ProductName', 'qtRequestory'),
            StringStruct('ProductVersion', '@VERSION@')
          ]
        )
      ]
    ),
    VarFileInfo([VarStruct('Translation', [1033, 1200])])
  ]
)
